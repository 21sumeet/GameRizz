# Copy to .env and fill in real values. Never commit .env.

# Groq API key. Get one at https://console.groq.com/keys
GROQ_API_KEY=

# Chat model id
GROQ_MODEL=

# OpenAI-compatible endpoint. Changing provider = change these 3 lines only.
GROQ_BASE_URL=

# Google Gemini embeddings (games + queries). Get one at https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Embedding model id + endpoint. Provider change = .env edit only.
GOOGLE_EMBEDDING_MODEL=
GOOGLE_EMBEDDING_BASE_URL=